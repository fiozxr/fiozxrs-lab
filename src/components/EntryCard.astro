---
interface Props {
  entry: any;
  kind?: "article" | "project";
}
const { entry, kind = "article" } = Astro.props;
const data = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = `${base}/${kind === "project" ? "projects" : "articles"}/${entry.slug}/`;
const date = data.pubDate.toLocaleDateString("en", { year: "numeric", month: "short", day: "numeric" });
---
<article class="entry-card">
  <div class="entry-card-top">
    <span class="eyebrow">{data.category}</span>
    <span class="entry-date">{date}</span>
  </div>
  <h3><a href={href}>{data.title}</a></h3>
  <p>{data.description}</p>
  <div class="entry-card-bottom">
    <div class="tag-list">
      {data.tags.slice(0, 2).map((tag: string) => <span class="tag">{tag}</span>)}
    </div>
    <a class="text-link" href={href}>Read {kind === "project" ? "project" : "article"} <span aria-hidden="true">↗</span></a>
  </div>
</article>
