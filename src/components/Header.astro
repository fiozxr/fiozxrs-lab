---
import { site } from "../data/site";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const current = Astro.url.pathname.replace(base, "") || "/";
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={`${base}/`} aria-label={`${site.name} home`}>
      <span class="wordmark-mark">F.</span>
      <span>{site.name}</span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {site.navigation.map((item) => (
        <a
          href={`${base}${item.href}`}
          class:list={["nav-link", current.startsWith(item.href) ? "is-active" : ""]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="icon-link search-link" href={`${base}/search/`} aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
      </a>
      <button class="icon-button theme-toggle" type="button" aria-label="Toggle colour theme" title="Toggle colour theme">
        <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
        <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.6 8.6 0 0 1 9.8 3.5 8.7 8.7 0 1 0 20.5 14.2Z"></path></svg>
      </button>
      <button class="menu-toggle icon-button" type="button" aria-label="Open navigation" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
  <nav class="mobile-nav shell" aria-label="Mobile navigation" hidden>
    {site.navigation.map((item) => <a href={`${base}${item.href}`}>{item.label}</a>)}
    <a href={`${base}/search/`}>Search</a>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const themeButton = document.querySelector(".theme-toggle");
  const menuButton = document.querySelector(".menu-toggle");
  const mobileNav = document.querySelector(".mobile-nav");

  const applyTheme = (theme) => {
    root.dataset.theme = theme;
    try { localStorage.setItem("fiozxr-theme", theme); } catch {}
  };

  let savedTheme = null;
  try { savedTheme = localStorage.getItem("fiozxr-theme"); } catch {}
  if (savedTheme === "light" || savedTheme === "dark") {
    applyTheme(savedTheme);
  } else {
    root.dataset.theme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
  }

  themeButton?.addEventListener("click", () => {
    applyTheme(root.dataset.theme === "dark" ? "light" : "dark");
  });

  menuButton?.addEventListener("click", () => {
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", String(!isOpen));
    mobileNav.hidden = isOpen;
  });
</script>
